# 本站對外部署的完整網址（含 protocol）
# 用途：astro.config.ts 的 site → canonical / og:url / og:image 絕對網址
# 未設定時 astro.config.ts 會 fallback 到下面這個預設值
SITE_URL=https://csstudio-demo-360.netlify.app

# API 網域（本站目前為純靜態展示，沒有實際打 API，但 src/site.config.ts 會讀取）
API_BASE_URL="https://dev-admin.csstudio.tw"

# 以下皆為選填，留空即不載入對應追蹤碼
# GA4 Tracking ID，格式 G-XXXXXXXXXX
GA4_TRACKING_ID=

# Google Tag Manager ID，格式 GTM-XXXXXXX
GTM_ID=

# LINE Tag ID，格式 xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LINE_TAG_ID=

# Microsoft Clarity ID
CLARITY_ID=

# Facebook Pixel ID
FB_PIXEL_ID=
