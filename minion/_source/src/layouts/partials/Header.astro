---
import { cn } from '@/utils/className'

interface Props {
  class?: astroHTML.JSX.HTMLAttributes['class']
}

const nav = [
  {
    label: 'Food',
    href: '/minion/',
    children: [
      { label: 'Human-grade fresh', href: '/minion/' },
      { label: 'Freeze-dried raw', href: '/minion/' },
    ],
  },
  { label: 'About us', href: '/minion/' },
  { label: 'Help', href: '/minion/' },
  { label: 'Theme features', href: '/minion/' },
]
---

{/* Announcement bar */}
<div class="bg-primary-500 text-center text-sm font-medium text-white">
  <div class="container py-2.5">
    😺🥩 FREE SHIPPING —
    <a href="/minion/" class="underline underline-offset-2 hover:text-white/80">
      no code needed, just head for checkout!
    </a>
  </div>
</div>

<header class={cn('sticky top-0 z-50 border-b border-navy/10 bg-white/95 backdrop-blur', Astro.props.class)}>
  <nav class="container flex items-center justify-between gap-4 py-4">
    {/* Logo */}
    <a href="/minion/" class="flex items-center gap-2 text-2xl font-extrabold text-navy">
      <span aria-hidden="true">😺</span>
      <span class="lowercase">minion</span>
    </a>

    {/* Desktop nav */}
    <ul class="hidden items-center gap-8 lg:flex">
      {nav.map(item => (
        <li class="group relative">
          <a
            href={item.href}
            class="flex items-center gap-1 py-2 text-sm font-semibold text-navy transition-colors hover:text-primary-600"
          >
            {item.label}
            {item.children && (
              <svg class="h-4 w-4 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M5.5 7.5L10 12l4.5-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" />
              </svg>
            )}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full min-w-52 rounded-xl border border-navy/10 bg-white p-2 opacity-0 shadow-card transition-all duration-200 group-hover:visible group-hover:opacity-100">
              {item.children.map(child => (
                <a href={child.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-cloud hover:text-primary-600">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>

    {/* Actions */}
    <div class="flex items-center gap-4">
      <a href="/minion/" aria-label="Account" class="text-navy hover:text-primary-600">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="8" r="4" /><path d="M4 20c0-4 4-6 8-6s8 2 8 6" stroke-linecap="round" />
        </svg>
      </a>
      <a href="/minion/" aria-label="Cart" class="relative text-navy hover:text-primary-600">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12z" stroke-linejoin="round" /><path d="M6 6L5 3H2" stroke-linecap="round" />
          <circle cx="9" cy="20" r="1.5" fill="currentColor" stroke="none" /><circle cx="18" cy="20" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </a>

      {/* Mobile menu */}
      <details class="group lg:hidden">
        <summary class="flex cursor-pointer list-none items-center text-navy">
          <svg class="h-7 w-7 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
          <svg class="hidden h-7 w-7 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-full border-b border-navy/10 bg-white p-4 shadow-card">
          <ul class="flex flex-col divide-y divide-navy/10">
            {nav.map(item => (
              <li class="py-1">
                <a href={item.href} class="block py-2 font-semibold text-navy">{item.label}</a>
                {item.children && (
                  <ul class="pb-2 pl-4">
                    {item.children.map(child => (
                      <li><a href={child.href} class="block py-1.5 text-sm text-navy/70">{child.label}</a></li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
