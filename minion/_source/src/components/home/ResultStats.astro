---
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { resultStats } from '@/data/home'
---

<section class="bg-white py-16 md:py-24">
  <div class="container flex flex-col items-center gap-12">
    <SectionHeading
      eyebrow="The results are in…"
      title="We asked our customers about their cat’s health"
      subtitle="…after making the switch to Minion."
    />
    <dl class="grid w-full grid-cols-2 gap-6 lg:grid-cols-4">
      {resultStats.map(stat => (
        <div class="flex flex-col items-center gap-2 rounded-2xl bg-mint px-6 py-8 text-center">
          <dt class="text-4xl font-extrabold text-primary-600 md:text-5xl">{stat.value}</dt>
          <dd class="text-sm font-medium text-navy/70">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
