---
import Button from '@/components/ui/Button.astro'
---

<section class="bg-pink py-16 md:py-24">
  <div class="container grid items-center gap-12 lg:grid-cols-2">
    <div class="order-2 lg:order-1">
      <img
        src="/minion/images/moneyback.png"
        alt="Minion money-back guarantee"
        width="720"
        height="600"
        loading="lazy"
        class="mx-auto w-full max-w-lg object-contain"
      />
    </div>
    <div class="order-1 flex flex-col gap-5 lg:order-2">
      <h2 class="text-3xl font-extrabold text-navy md:text-4xl lg:text-5xl">
        Money-back guarantee 💸
      </h2>
      <p class="max-w-md text-lg text-navy/70">
        We’ll refund you if your cats won’t eat it.
      </p>
      <div>
        <Button href="/minion/" variant="navy" size="lg">Get started</Button>
      </div>
    </div>
  </div>
</section>
