---
import SectionHeading from '@/components/ui/SectionHeading.astro'
---

<section class="bg-cloud py-16 md:py-24">
  <div class="container grid items-center gap-10 lg:grid-cols-2">
    <div class="order-2 overflow-hidden rounded-3xl lg:order-1">
      <img
        src="/minion/images/vet.jpg"
        alt="Amanda Smith, resident veterinary expert, holding a cat"
        width="680"
        height="520"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="order-1 flex flex-col gap-4 lg:order-2">
      <SectionHeading
        eyebrow="Meet our resident vet!"
        title="Amanda Smith — veterinary expert 😺"
        align="left"
      />
      <p class="text-lg text-navy/70">
        The Minion has a resident veterinarian, Amanda Smith. She supports animal charities
        and shares her knowledge of pet care. As a full-time veterinarian, Amanda knows what
        cats need to be healthy.
      </p>
    </div>
  </div>
</section>
