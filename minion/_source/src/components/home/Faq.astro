---
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { faqs } from '@/data/home'
---

<section class="bg-white py-16 md:py-24">
  <div class="container flex max-w-3xl flex-col items-center gap-10">
    <SectionHeading eyebrow="FAQs" title="Everything you need to know" />
    <div class="w-full divide-y divide-navy/10">
      {faqs.map((faq, i) => (
        <details class="group py-5" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-bold text-navy">
            {faq.question}
            <svg
              class="h-5 w-5 shrink-0 text-primary-600 transition-transform duration-200 group-open:rotate-45"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M10 4v12M4 10h12" />
            </svg>
          </summary>
          <p class="mt-3 text-navy/70">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
