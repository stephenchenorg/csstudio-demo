---
import Button from '@/components/ui/Button.astro'
---

<section class="relative overflow-hidden bg-[#f9d3dc]">
  <div class="container grid items-center gap-8 py-10 lg:grid-cols-2 lg:py-4">
    <div class="order-2 max-w-xl lg:order-1">
      <h1 class="text-4xl font-extrabold leading-[1.1] tracking-tight text-navy md:text-5xl lg:text-6xl">
        Trusted nutrition for your cat 🍗
      </h1>
      <p class="mt-6 text-lg text-navy/75 md:text-xl">
        Minion makes it easy to serve our feline friends hearty, wholesome meals,
        keeping them healthy and happy for all nine of their lives.
      </p>
      <div class="mt-8">
        <Button href="/minion/" size="lg" variant="navy">Shop Now!</Button>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <img
        src="/minion/images/hero.jpg"
        alt="Minion cat food range with a happy cat"
        width="1000"
        height="560"
        fetchpriority="high"
        class="mx-auto w-full max-w-2xl object-contain"
      />
    </div>
  </div>
</section>
