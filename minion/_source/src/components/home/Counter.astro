---
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { counterStats } from '@/data/home'
---

<section class="bg-navy py-16 md:py-24">
  <div class="container flex flex-col items-center gap-12">
    <SectionHeading eyebrow="Counter" title="Paws, love &amp; numbers" light />
    <dl class="grid w-full gap-8 text-center md:grid-cols-3">
      {counterStats.map(stat => (
        <div class="flex flex-col items-center gap-2">
          <dt class="text-5xl font-extrabold text-primary-300 md:text-6xl">{stat.value}</dt>
          <dd class="max-w-xs text-white/75">{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
