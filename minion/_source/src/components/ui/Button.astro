---
import { cn } from '@/utils/className'

interface Props {
  href?: string
  variant?: 'primary' | 'navy' | 'outline' | 'white'
  size?: 'md' | 'lg'
  class?: astroHTML.JSX.HTMLAttributes['class']
}

const { href, variant = 'primary', size = 'md', class: className } = Astro.props

const base
  = 'inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-colors duration-200 whitespace-nowrap'

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-primary-500 text-white hover:bg-primary-600',
  navy: 'bg-navy text-white hover:bg-primary-600',
  outline: 'border-2 border-navy text-navy hover:bg-navy hover:text-white',
  white: 'bg-white text-navy hover:bg-primary-500 hover:text-white shadow-card',
}

const sizes: Record<NonNullable<Props['size']>, string> = {
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
}

const classes = cn(base, variants[variant], sizes[size], className)
const Tag = href ? 'a' : 'button'
---

<Tag class={classes} {...href ? { href } : {}}>
  <slot />
</Tag>
