---
interface Props {
  rating?: number
  class?: astroHTML.JSX.HTMLAttributes['class']
}

const { rating = 5, class: className } = Astro.props
const stars = Array.from({ length: 5 }, (_, i) => i < Math.round(rating))
---

<div class:list={['flex items-center gap-0.5', className]} aria-label={`${rating} out of 5 stars`}>
  {stars.map(filled => (
    <svg
      class:list={[filled ? 'text-amber-400' : 'text-gray-300', 'h-4 w-4']}
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M10 1.5l2.6 5.27 5.82.85-4.21 4.1.99 5.79L10 14.77l-5.2 2.73.99-5.79L1.58 7.62l5.82-.85L10 1.5z" />
    </svg>
  ))}
</div>
